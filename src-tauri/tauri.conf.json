{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-sync-ui",
  "version": "0.2.6",
  "identifier": "com.ssallem.claudesyncui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "claude-sync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' data:; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/claude-sync"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\\x64\\signtool.exe",
        "args": [
          "sign",
          "/sha1",
          "F382A7A6DDFD342F44AE9E0010A328BD487CEDE5",
          "/fd",
          "sha256",
          "/tr",
          "http://timestamp.digicert.com",
          "/td",
          "sha256",
          "%1"
        ]
      }
    }
  }
}
