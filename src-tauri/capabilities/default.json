{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/claude-sync",
          "sidecar": true,
          "args": [
            { "validator": "^(init|status|push|pull|doctor|--version)$" },
            { "validator": "^-m$" },
            { "validator": "^[^\\x00-\\x1f\\x7f]{1,2048}$" }
          ]
        }
      ]
    }
  ]
}
